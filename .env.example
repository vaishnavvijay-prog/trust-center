# ---------------------------------------------------------------------------
# Per-deployment config. One copy of this repo serves every brand; everything
# that differs between brands is an env var here (plus that brand's own
# Cloudflare D1 database, which holds the page CONTENT).
# ---------------------------------------------------------------------------

# --- Auth -------------------------------------------------------------------
# Must be the deployment's real public origin, e.g. https://trust.getzuro.com
NEXTAUTH_URL=http://localhost:3000
# Generate a fresh one per deployment: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me

# GitHub OAuth app, one per deployment (the callback URL is origin-specific).
# Callback URL: <NEXTAUTH_URL>/api/auth/callback/github
GITHUB_ID=your-github-client-id
GITHUB_SECRET=your-github-client-secret

# Comma-separated list of emails allowed to access admin area.
# REQUIRED: if empty, NO ONE can access admin. That is deliberate.
ADMIN_EMAILS=admin@yourcompany.com

# --- Content store (Cloudflare D1) ------------------------------------------
# Each brand has its own D1 database; the repo is shared, the data is not.
# The app reaches D1 over the HTTP query API (it runs on DigitalOcean, not a
# Worker), so it needs an API token. That token MUST be scoped to D1:Edit on
# ONLY the trust databases — an account-wide token would let a compromised
# deploy reach production D1s. See docs/SETUP.md.
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_D1_ID=this-brands-d1-database-uuid
CF_API_TOKEN=scoped-d1-edit-token

# --- Branding ---------------------------------------------------------------
# Read server-side only (see src/lib/brand.ts). All have safe fallbacks.
# BRAND_PRIMARY must be an OKLCH string; it drives buttons, links, focus rings.
BRAND_NAME=Your Company
BRAND_PRIMARY=oklch(0.55 0.258 284)
BRAND_PRIMARY_FOREGROUND=oklch(0.985 0 0)
BRAND_FONT=Figtree
BRAND_FONT_WEIGHTS=300;400;500;600;700;800
BRAND_FOOTER=© 2026 Zuro

# Known brand values (hex -> oklch already converted):
#   Auralis    violet #5B3DF5 -> oklch(0.55 0.258 284)      font Figtree    theme light
#   Zuro       violet #5548FE -> oklch(0.5407 0.2561 276.7) font Figtree    theme dark
#   Dashverge  azure  #2d6cdf -> oklch(0.5569 0.1874 261.2) font Open Sans  theme light
#   Astridex   green  #006241 -> oklch(0.4384 0.0965 161.7) font Open Sans  theme light
# `theme` is NOT an env var — it comes from the YAML (`theme: light|dark`).
